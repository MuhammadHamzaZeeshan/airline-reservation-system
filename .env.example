# Copy to .env (make does this automatically). Never commit .env.
COMPOSE_PROJECT_NAME=ars
COMPOSE_FILE=docker-compose.lite.yml

# PostgreSQL / Citus
POSTGRES_DB=ars
POSTGRES_USER=ars
POSTGRES_PASSWORD=change_me_ars_pw

# API -> PgBouncer (transaction pooling) -> Citus coordinator
PG_HOST=pgbouncer
PG_PORT=5432
PG_POOL_MIN=2
PG_POOL_MAX=10
USE_REPLICAS=false

REDIS_URL=redis://redis:6379/0

# Polyglot stores
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
MONGO_RS_MEMBERS=mongo:27017
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_pw
CLICKHOUSE_URL=http://clickhouse:8123/
CLICKHOUSE_USER=ars
CLICKHOUSE_PASSWORD=change_me_ch_pw

# API
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
RATE_LIMIT_RPS=200
RATE_LIMIT_BURST=400
BCRYPT_ROUNDS=10
HOLD_TTL_SECONDS=600

# Workers
RECONCILE_INTERVAL=30

# Simulation controller (admin panel) and Grafana
SIMCTL_TOKEN=change_me_simctl_token
GRAFANA_PASSWORD=admin

# Host ports (bound to localhost only)
HTTP_PORT=8080
HTTP_PORT_2=8081
PG_PUBLIC_PORT=5432
REDIS_PUBLIC_PORT=6379
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
